# ═══════════════════════════════════════════════════════════
# course-startup — 开发启动指令
# ═══════════════════════════════════════════════════════════
#
# 用法: 在项目根目录执行 bash .codex/commands/course-startup
# 效果: AI 读取本指令 → 自动执行完整开发流程
# 
# 说明:
# - 本指令是一个自包含的开发管线
# - AI 读取后按阶段自动推进，不需要人记任何东西
# - 每个阶段 AI 从可用技能池中自主选配技能
# - 用户只需要在关键节点确认"继续"或"调整"
#
# ═══════════════════════════════════════════════════════════

# ============================================================
# 阶段 1: 初始探测
# ============================================================
# AI 检测 .planning/STATE.md 是否存在
# 不存在 → 执行 orchestrate-projects 初始化
# 存在   → 读取 active_state，跳到对应阶段
# ============================================================

# ============================================================
# 阶段 2: 需求定义
# ============================================================
# 可用技能池（AI 自主选配）:
#   [主] interview-me             — 访谈需求
#   [主] spec-driven-development  — 写可验证需求
#   [辅] context-engineering      — 加载上下文
#   [辅] brainstorming            — 创意发散
#   [辅] idea-refine              — 想法收敛
#   [辅] research-collector       — 收集参考
#   [辅] insight-miner            — 挖掘洞察
#   [辅] takeaway-skill           — 研究参考案例
# ============================================================

# ============================================================
# 阶段 3: 计划定义
# ============================================================
# 可用技能池（AI 自主选配）:
#   [主] planning-and-task-breakdown  — 拆里程碑
#   [辅] writing-plans                — 补充计划
#   [辅] task-alignment               — 任务对齐
# ============================================================

# ============================================================
# 阶段 4: 构建循环
# ============================================================
# 每里程碑自动执行，直到全部完成
#
# 分派架构:
#   主线程: orchestrate-projects + dispatching-parallel-agents
#   ├→ 内容 Agent: source-driven-dev, research-collector, insight-miner, context-eng, vibe-idea(adapted)
#   ├→ UI Agent: frontend-ui-eng, html-interactive, web-design-engineer, hallmark, viz-*
#   ├→ 验证 Agent: verification, check, code-review, debugging, browser-testing, doubt-driven-dev
#   └→ 主线程合并 → 更新状态 → 下一里程碑
# ============================================================

# ============================================================
# 阶段 5: 项目收尾
# ============================================================
# 可用技能池（AI 自主选配）:
#   [主] documentation-and-adrs   — 记录决策
#   [辅] code-review-and-quality  — 全局审查
#   [辅] code-simplification      — 简化
#   [辅] performance-optimization — 性能优化
#   [辅] git-workflow-and-versioning — 版本管理
#   [辅] shipping-and-launch      — 部署
# ============================================================

# ============================================================
# AI 执行说明（重要：AI 读取本文件后按此执行）
# ============================================================
# 
# 1. 检测 .planning/STATE.md 的 active_state
# 2. 根据状态匹配对应阶段
# 3. 从该阶段的可用技能池中自主选择技能组合
#    - [主] = 至少选一个
#    - [辅] = 根据当前上下文判断是否需要
#    - 同一阶段可并行多个技能
# 4. 每个技能执行完后，更新 STATE.md
# 5. 向用户输出三行简报：
#    ✅ 已完成：[做了什么]
#    ⏳ 下一步：[接下来做什么]
#    ❓ 需要你：[需要用户确认的事项]
# 6. 等待用户确认后继续
# 7. 不要展示技能名，只展示"在做什么"
#
# 用户不需要：
#   - 不需要记住任何技能名
#   - 不需要知道当前在第几阶段
#   - 不需要看流程图
#   - 只需要说"继续"或"调整"
#
# ============================================================

echo "╔═══════════════════════════════════════════════╗"
echo "║  人机协同实战课 · 开发指令                   ║"
echo "║  输入一次，自动推进                          ║"
echo "╚═══════════════════════════════════════════════╝"

# 状态检测
if [ ! -f ".planning/STATE.md" ]; then
    echo "▸ 当前: 未初始化"
    echo "   → 请先执行初始化"
    echo ""
    echo "   AI 将调用 orchestrate-projects 建立项目骨架"
elif grep -q "Active State.*interviewing\|project_defined" .planning/STATE.md 2>/dev/null; then
    echo "▸ 当前: 需求定义阶段"
    echo "   → AI 正在从技能池中选配..."
    echo "   → 可用: interview-me / spec-driven-dev / brainstorming / ..."
elif grep -q "Active State.*requirements_defined\|roadmap_ready" .planning/STATE.md 2>/dev/null; then
    echo "▸ 当前: 计划阶段"
    echo "   → AI 正在从技能池中选配..."
    echo "   → 可用: planning-and-task-breakdown / writing-plans / ..."
elif grep -q "Active State.*milestone" .planning/STATE.md 2>/dev/null; then
    echo "▸ 当前: 构建阶段"
    echo "   → AI 正在并行调度..."
    echo "   → 内容 Agent + UI Agent + 验证 Agent"
elif grep -q "Active State.*project_complete" .planning/STATE.md 2>/dev/null; then
    echo "▸ 当前: 已完成"
    echo "   → 进入收尾流程"
fi

echo ""
echo "──────────────────────────────────────"
echo "  AI 已读取指令，正在按管线推进..."
echo "  你只需要确认"继续"或"调整""
echo "──────────────────────────────────────"
